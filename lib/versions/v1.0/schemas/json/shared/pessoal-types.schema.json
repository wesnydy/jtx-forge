{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://www.example.org/pessoal-types.schema.json",
  "title": "Pessoal Types Schema",
  "$defs": {
    "EstudanteType": {
      "type": "object",
      "required": [
        "ID",
        "Nome",
        "CPF"
      ],
      "properties": {
        "ID": {
          "$ref": "simple-types.schema.json#/$defs/IDType"
        },
        "Nome": {
          "$ref": "simple-types.schema.json#/$defs/StringType"
        },
        "CPF": {
          "$ref": "simple-types.schema.json#/$defs/CPFType"
        }
      },
      "additionalProperties": false
    }
  }
}