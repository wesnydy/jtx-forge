{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://www.example.org/academico-types.schema.json",
  "title": "Acadêmico Types Schema",
  "$defs": {
    "CursoType": {
      "type": "object",
      "required": [
        "Nome",
        "Codigo"
      ],
      "properties": {
        "Nome": {
          "$ref": "simple-types.schema.json#/$defs/StringType"
        },
        "Codigo": {
          "$ref": "simple-types.schema.json#/$defs/StringType"
        },
        "Nivel": {
          "$ref": "simple-types.schema.json#/$defs/NivelCursoType"
        }
      },
      "additionalProperties": false
    },
    "DisciplinaType": {
      "type": "object",
      "required": [
        "Nome",
        "Codigo",
        "Creditos",
        "CargaHoraria",
        "Situacao"
      ],
      "oneOf": [
        {
          "required": [
            "Nota"
          ],
          "properties": {
            "Nota": {
              "$ref": "simple-types.schema.json#/$defs/NotaType"
            }
          }
        },
        {
          "required": [
            "NotaEscala"
          ],
          "properties": {
            "NotaEscala": {
              "$ref": "simple-types.schema.json#/$defs/EscalaConceitoType"
            }
          }
        }
      ],
      "properties": {
        "Nome": {
          "$ref": "simple-types.schema.json#/$defs/StringType"
        },
        "Codigo": {
          "$ref": "simple-types.schema.json#/$defs/NumberType"
        },
        "Creditos": {
          "$ref": "simple-types.schema.json#/$defs/NumberType"
        },
        "CargaHoraria": {
          "$ref": "simple-types.schema.json#/$defs/NumberType"
        },
        "Frequencia": {
          "$ref": "simple-types.schema.json#/$defs/PercentType"
        },
        "Situacao": {
          "$ref": "simple-types.schema.json#/$defs/SituacaoType"
        },
        "Comentarios": {
          "$ref": "simple-types.schema.json#/$defs/StringType"
        },
        "Nota": true,
        "NotaEscala": true
      },
      "additionalProperties": false
    },
    "DisciplinaArrayType": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "Disciplina"
        ],
        "properties": {
          "Disciplina": {
            "$ref": "#/$defs/DisciplinaType"
          }
        },
        "additionalProperties": false
      }
    },
    "PeriodoType": {
      "type": "object",
      "required": [
        "Codigo",
        "Inicio",
        "Fim",
        "Disciplinas"
      ],
      "properties": {
        "Codigo": {
          "$ref": "simple-types.schema.json#/$defs/StringType"
        },
        "Inicio": {
          "$ref": "simple-types.schema.json#/$defs/DateType"
        },
        "Fim": {
          "$ref": "simple-types.schema.json#/$defs/DateType"
        },
        "Disciplinas": {
          "$ref": "#/$defs/DisciplinaArrayType"
        }
      },
      "additionalProperties": false
    },
    "PeriodoArrayType": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "Periodo"
        ],
        "properties": {
          "Periodo": {
            "$ref": "#/$defs/PeriodoType"
          }
        },
        "additionalProperties": false
      }
    }
  }
}