{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://www.example.org/simple-types.schema.json",
  "title": "Simple Types Schema",
  "$defs": {
    "StringType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "NumberType": {
      "type": "string",
      "pattern": "^[1-9]{1,4}$"
    },
    "DecimalType": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]{2}$"
    },
    "DateType": {
      "type": "string",
      "format": "date"
    },
    "IDType": {
      "type": "string",
      "pattern": "^[A-Za-z]+-[0-9]{1,4}$"
    },
    "Base64BinaryType":{
      "type": "string",
      "contentEncoding": "base64"
    },
    "PhoneType": {
      "type": "string",
      "pattern": "^[0-9]{9}$"
    },
    "CPFType": {
      "type": "string",
      "pattern": "^[0-9]{11}$"
    },
    "CNPJType": {
      "type": "string",
      "pattern": "^[0-9a-zA-Z]{14}$"
    },
    "CEPType": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "UFType": {
      "type": "string",
      "enum": [
        "AC",
        "AL",
        "AM",
        "AP",
        "BA",
        "CE",
        "DF",
        "ES",
        "GO",
        "MA",
        "MG",
        "MS",
        "MT",
        "PA",
        "PB",
        "PE",
        "PI",
        "PR",
        "RJ",
        "RN",
        "RO",
        "RR",
        "RS",
        "SC",
        "SE",
        "SP",
        "TO"
      ]
    },
    "PercentType": {
      "type": "string",
      "pattern": "^(100|[0-9]{1,2})(\\.[0-9]{1,2})?$"
    },
    "NotaType": {
      "type": "string",
      "pattern": "^(10|[0-9]{1,2})(\\.[0-9]{1,2})?$"
    },
    "SituacaoType": {
      "type": "string",
      "enum": [
        "Aprovado",
        "Reprovado",
        "Recuperação",
        "Matriculado",
        "Dispensado"
      ]
    },
    "EscalaConceitoType": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F"
      ]
    },
    "NivelCursoType": {
      "type": "string",
      "enum": [
        "Bacharelado",
        "Licenciatura",
        "Tecnólogo"
      ]
    }
  }
}