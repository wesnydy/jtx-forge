{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://www.example.org/boletim-types.schema.json",
  "title": "Boletim Types Schema",
  "$defs": {
    "CabecalhoType": {
      "type": "object",
      "required": [
        "Instituicao",
        "IdentificadorDocumento",
        "DataEmissao"
      ],
      "properties": {
        "Instituicao": {
          "$ref": "institucional-types.schema.json#/$defs/InstituicaoType"
        },
        "IdentificadorDocumento": {
          "$ref": "simple-types.schema.json#/$defs/IDType"
        },
        "Emitente": {
          "$ref": "simple-types.schema.json#/$defs/StringType"
        },
        "DataEmissao": {
          "$ref": "simple-types.schema.json#/$defs/DateType"
        }
      },
      "additionalProperties": false
    },
    "ResumoAcademicoType": {
      "type": "object",
      "required": [
        "CRA",
        "TotalCreditosConcluidos"
      ],
      "properties": {
        "CRA": {
          "$ref": "simple-types.schema.json#/$defs/DecimalType"
        },
        "TotalCreditosConcluidos": {
          "$ref": "simple-types.schema.json#/$defs/DecimalType"
        },
        "Observacoes": {
          "$ref": "simple-types.schema.json#/$defs/StringType"
        }
      },
      "additionalProperties": false
    },
    "AssinaturaType": {
      "type": "object",
      "required": [
        "NomeAssinador",
        "Cargo",
        "Data",
        "AssinaturaDigital"
      ],
      "properties": {
        "NomeAssinador": {
          "$ref": "simple-types.schema.json#/$defs/StringType"
        },
        "Cargo": {
          "$ref": "simple-types.schema.json#/$defs/StringType"
        },
        "Data": {
          "$ref": "simple-types.schema.json#/$defs/DateType"
        },
        "AssinaturaDigital": {
          "$ref": "simple-types.schema.json#/$defs/Base64BinaryType"
        }
      },
      "additionalProperties": false
    },
    "AssinaturaArrayType": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "Assinatura"
        ],
        "properties": {
          "Assinatura": {
            "$ref": "#/$defs/AssinaturaType"
          }
        },
        "additionalProperties": false
      }
    }
  }
}