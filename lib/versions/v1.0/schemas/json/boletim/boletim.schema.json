{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://www.example.org/boletim.schema.json",
  "title": "Boletim Schema",
  "oneOf": [
    {
      "$ref": "boletim.schema.json#/$defs/Boletim"
    },
    {
      "$ref": "boletim.schema.json#/$defs/LoteBoletim"
    }
  ],
  "$defs": {
    "Boletim": {
      "type": "object",
      "required": [
        "Boletim"
      ],
      "properties": {
        "Boletim": {
          "$ref": "boletim.schema.json#/$defs/BoletimType"
        }
      },
      "additionalProperties": false
    },
    "LoteBoletim": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "Boletim"
        ],
        "properties": {
          "Boletim": {
            "$ref": "boletim.schema.json#/$defs/BoletimType"
          }
        },
        "additionalProperties": false
      }
    },
    "BoletimType": {
      "type": "object",
      "required": [
        "Versao",
        "Cabecalho",
        "Estudante",
        "Curso",
        "Periodos",
        "ResumoAcademico"
      ],
      "properties": {
        "Versao": {
          "type": "string",
          "const": "1.0"
        },
        "Cabecalho": {
          "type": "object",
          "required": [
            "Instituicao",
            "IdentificadorDocumento",
            "DataEmissao"
          ],
          "properties": {
            "Instituicao": {
              "$ref": "boletim-types.schema.json#/$defs/InstituicaoType"
            },
            "IdentificadorDocumento": {
              "$ref": "simple-types.schema.json#/$defs/IDType"
            },
            "Emitente": {
              "$ref": "simple-types.schema.json#/$defs/StringType"
            },
            "DataEmissao": {
              "$ref": "simple-types.schema.json#/$defs/DateType"
            }
          },
          "additionalProperties": false
        },
        "Estudante": {
          "$ref": "boletim-types.schema.json#/$defs/EstudanteType"
        },
        "Curso": {
          "$ref": "boletim-types.schema.json#/$defs/CursoType"
        },
        "Periodos": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "Periodo"
            ],
            "properties": {
              "Periodo": {
                "$ref": "boletim-types.schema.json#/$defs/PeriodoType"
              }
            },
            "additionalProperties": false
          }
        },
        "ResumoAcademico": {
          "$ref": "boletim-types.schema.json#/$defs/ResumoAcademicoType"
        },
        "Assinaturas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "Assinatura"
            ],
            "properties": {
              "Assinatura": {
                "$ref": "boletim-types.schema.json#/$defs/AssinaturaType"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}