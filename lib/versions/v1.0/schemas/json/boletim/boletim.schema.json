{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://www.example.org/boletim.schema.json",
  "title": "Boletim Schema",
  "oneOf": [
    {
      "$ref": "boletim.schema.json#/$defs/Boletim"
    },
    {
      "$ref": "boletim.schema.json#/$defs/LoteBoletim"
    }
  ],
  "$defs": {
    "Boletim": {
      "type": "object",
      "required": [
        "Boletim"
      ],
      "properties": {
        "Boletim": {
          "$ref": "boletim.schema.json#/$defs/BoletimType"
        }
      },
      "additionalProperties": false
    },
    "LoteBoletim": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "boletim.schema.json#/$defs/Boletim"
      }
    },
    "BoletimType": {
      "type": "object",
      "required": [
        "Versao",
        "Cabecalho",
        "Estudante",
        "Curso",
        "Periodos",
        "ResumoAcademico"
      ],
      "properties": {
        "Versao": {
          "type": "string",
          "const": "1.0"
        },
        "Cabecalho": {
          "$ref": "boletim-types.schema.json#/$defs/CabecalhoType"
        },
        "Estudante": {
          "$ref": "pessoal-types.schema.json#/$defs/EstudanteType"
        },
        "Curso": {
          "$ref": "academico-types.schema.json#/$defs/CursoType"
        },
        "Periodos": {
          "$ref": "academico-types.schema.json#/$defs/PeriodoArrayType"
        },
        "ResumoAcademico": {
          "$ref": "boletim-types.schema.json#/$defs/ResumoAcademicoType"
        },
        "Assinaturas": {
          "$ref": "boletim-types.schema.json#/$defs/AssinaturaArrayType"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}