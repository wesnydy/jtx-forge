{
  "name": "jtx-forge",
  "version": "0.0.1",
  "description": "JTX Forge is a library for generating structured XML documents from JSON data in a standardized and extensible way.",
  "main": "dist/index.ts",
  "scripts": {
    "start": "npm run build && node dist/index.js",
    "start:dev": "tsx watch lib/index.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "build": " rm -rf dist && tsc --outDir dist",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Wesnydy Ribeiro",
  "license": "Apache-2.0",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "xmlbuilder2": "^4.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.33.0",
    "@eslint/json": "^0.13.1",
    "@eslint/markdown": "^7.1.0",
    "@types/node": "^24.10.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.0.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.1.5",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ],
    "*.ts": [
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "type": "module",
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
